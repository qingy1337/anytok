+impl Drop for Lattice<'_> {
+    fn drop(&mut self) {
+        // Backtrace nodes own their predecessors through Rc. Clear those
+        // links while the lattice still owns every node, so dropping a long
+        // path cannot recursively release the entire chain on the stack.
+        for node in &self.nodes {
+            node.borrow_mut().prev = None;
+        }
+    }
+}
