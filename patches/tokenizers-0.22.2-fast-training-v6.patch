+// Training-only occurrence index. Short pretokens retain the compact vector
+// implementation; long segments locate a merge's occurrences directly.
+#[derive(Default)]
+pub(super) struct TrainingWord {
+    word: Word,
+    occurrences: Option<AHashMap<Pair, Occurrences>>,
+}
+#[derive(Default)]
+struct Occurrences { live: usize, positions: Vec<usize> }
+
+impl TrainingWord {
+    pub(super) fn from_word(word: Word) -> Self {
+        let mut result = Self { word, occurrences: None };
+        if result.word.symbols.len() >= 128 {
+            result.occurrences = Some(AHashMap::new());
+            for i in 0..result.word.symbols.len().saturating_sub(1) {
+                result.add_pair((result.word.symbols[i].c, result.word.symbols[i+1].c), i);
+            }
+        }
+        result
+    }
+    fn add_pair(&mut self, pair: Pair, position: usize) {
+        let value = self.occurrences.as_mut().unwrap().entry(pair).or_default();
+        value.live += 1; value.positions.push(position);
+    }
+    fn remove_pair(&mut self, pair: Pair) {
+        let index = self.occurrences.as_mut().unwrap();
+        let value = index.get_mut(&pair).expect("live adjacency must have an occurrence");
+        value.live -= 1;
+        if value.live == 0 { index.remove(&pair); }
+    }
+    pub(super) fn contains_pair(&self, pair: Pair) -> bool {
+        if let Some(index) = &self.occurrences { index.get(&pair).is_some_and(|v| v.live > 0) }
+        else { self.word.get_chars_iter().zip(self.word.get_chars_iter().skip(1)).any(|p|p == pair) }
+    }
+    pub(super) fn get_chars(&self) -> Vec<u32> {
+        self.word.symbols.iter().filter(|s|s.len != 0).map(|s|s.c).collect()
+    }
+    pub(super) fn merge(&mut self, c1:u32, c2:u32, replacement:u32, max_length:usize) -> Vec<(Pair,i32)> {
+        if self.occurrences.is_none() { return self.word.merge(c1,c2,replacement,max_length); }
+        let selected = (c1,c2);
+        let Some(entry) = self.occurrences.as_mut().unwrap().get_mut(&selected) else { return vec![]; };
+        let mut positions = std::mem::take(&mut entry.positions);
+        positions.sort_unstable(); positions.dedup();
+        let mut changes = vec![];
+        for i in positions {
+            let first = self.word.symbols[i];
+            if first.len == 0 || first.c != c1 || first.next < 0 { continue; }
+            let j = first.next as usize; let second = self.word.symbols[j];
+            if second.len == 0 || second.c != c2 { continue; }
+            let new_len = first.len+second.len;
+            let left = if first.prev >= 0 { Some((first.prev as usize,self.word.symbols[first.prev as usize])) } else { None };
+            let right = if second.next >= 0 { Some((second.next as usize,self.word.symbols[second.next as usize])) } else { None };
+            self.remove_pair(selected);
+            if let Some((_, symbol)) = left {
+                self.remove_pair((symbol.c, first.c));
+                changes.push(((symbol.c, first.c),-1));
+                if symbol.len+new_len < max_length { changes.push(((symbol.c,replacement),1)); }
+            }
+            if let Some((_, symbol)) = right {
+                self.remove_pair((second.c,symbol.c));
+                changes.push(((second.c,symbol.c),-1));
+                if symbol.len+new_len < max_length { changes.push(((replacement,symbol.c),1)); }
+            }
