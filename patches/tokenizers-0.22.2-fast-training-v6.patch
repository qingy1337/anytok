+    // Exact unique-best segmentation over flat predecessor arrays. A tie is
+    // returned explicitly so pruning can retain the original A* tie behavior.
+    fn flat_best_path(&self, text: &str, excluded: Option<usize>) -> Option<(Vec<usize>, bool)> {
+        let len = text.len();
+        let mut scores = vec![f64::NEG_INFINITY; len+1];
+        let mut prev: Vec<Option<(usize, usize)>> = vec![None; len+1];
+        let mut tied = vec![false; len+1];
+        scores[0] = 0.0;
+        for (start, character) in text.char_indices() {
+            if !scores[start].is_finite() { continue; }
+            let width = character.len_utf8();
+            let mut single = false;
+            let mut visit = |n: usize, id: usize, score: f64| {
+                if n == width { single = true; }
+                if excluded == Some(id) { return; }
+                let end = start+n; let candidate = scores[start]+score;
+                let close = scores[end].is_finite() && (candidate-scores[end]).abs() <= 1e-12*(1.0+candidate.abs()+scores[end].abs());
+                if prev[end].is_none() || candidate > scores[end] {
+                    scores[end] = candidate; prev[end] = Some((start, id)); tied[end] = tied[start] || close;
+                } else if close { tied[end] = true; }
+            };
+            for (n, id) in self.trie.common_prefix_ids(text[start..].bytes()) { visit(n, id, self.vocab[id].1); }
+            if !single {
+                if let Some(id) = self.unk_id {
+                    let end = start+width; let candidate = scores[start]+(self.min_score-K_UNK_PENALTY);
+                    let close = scores[end].is_finite() && (candidate-scores[end]).abs() <= 1e-12*(1.0+candidate.abs()+scores[end].abs());
+                    if prev[end].is_none() || candidate > scores[end] {
+                        scores[end] = candidate; prev[end] = Some((start,id)); tied[end] = tied[start] || close;
+                    } else if close { tied[end] = true; }
+                }
+            }
+        }
+        if !scores[len].is_finite() { return None; }
+        let mut result = vec![]; let mut at = len;
+        while at > 0 { let (before,id) = prev[at]?; result.push(id); at = before; }
+        result.reverse(); Some((result,tied[len]))
+    }
+
+    pub(super) fn flat_prune_alternative(&self, text: &str, id: usize) -> Option<(bool, Vec<usize>)> {
+        let (best, tied) = self.flat_best_path(text, None)?;
+        if tied || best.is_empty() { return None; }
+        if best.len() >= 2 { return Some((false, vec![])); }
+        if best[0] != id { return None; }
+        match self.flat_best_path(text, Some(id)) {
+            None => Some((true, vec![])),
+            Some((alternative, false)) => Some((true, alternative)),
+            Some((_, true)) => None,
         }
     }

