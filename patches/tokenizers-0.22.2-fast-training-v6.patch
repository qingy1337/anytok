+                let first = self.symbols[read];
+                let second = self.symbols[read + 1];
+                let new_s = Symbol {
+                    c: replacement, prev: first.prev, next: second.next,
+                    len: first.len + second.len,
+                };
+                if write > 0 {
+                    let left = self.symbols[write - 1];
+                    changes.push(((left.c, first.c), -1));
+                    if left.len + new_s.len < max_length {
+                        changes.push(((left.c, replacement), 1));
+                    }
+                }
+                if read + 2 < self.symbols.len() {
+                    let right = self.symbols[read + 2];
+                    changes.push(((second.c, right.c), -1));
+                    if right.len + new_s.len < max_length {
+                        changes.push(((replacement, right.c), 1));
+                    }
+                }
+                self.symbols[write] = new_s;
+                read += 2;
+            } else {
+                self.symbols[write] = self.symbols[read];
+                read += 1;
+            }
+            write += 1;
+        }
+        self.symbols.truncate(write);
+
+        changes
+    }
